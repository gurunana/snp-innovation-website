# ============================================================
#  SNP Innovation Website — Environment Variables
#  Copy this file to ".env" and fill in your real values.
#  IMPORTANT: .env must be present BEFORE running "npm run build"
#  because Vite bakes these values into the static build output.
# ============================================================

# -- Supabase (free at supabase.com) --------------------------
# Get from: Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -- Admin Dashboard (/admin) ---------------------------------
# Choose any password -- this protects the admin panel
VITE_ADMIN_PASSWORD=snpadmin2025

# -- Web3Forms (free at web3forms.com) ------------------------
# Get from: web3forms.com -> enter dhokeayush0@gmail.com -> Create Key
# Then paste that key inside src/utils/api.js:
#   const WEB3FORMS_ACCESS_KEY = 'paste-your-key-here';

# -- Spring Boot Backend (future -- optional) -----------------
# Uncomment when your Spring Boot API is deployed
# VITE_API_BASE_URL=https://your-spring-boot-api.onrender.com/api
